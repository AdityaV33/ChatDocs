# The app supports swapping out the text-generation provider while keeping embeddings strictly on OpenAI.

# --- OPENAI (Embeddings + Generation) ---
# OPENAI_API_KEY is REQUIRED because text-embedding-3-small is ALWAYS used for vectorization.
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-3.5-turbo

# --- GROQ (Alternative Generation) ---
# To use Groq instead of OpenAI for answering questions and summarizing:
# GROQ_API_KEY=your_groq_api_key_here

# GENERATION_PROVIDER must be 'openai' or 'groq'
# GENERATION_PROVIDER=openai

# If GENERATION_PROVIDER is 'groq', you MUST specify a valid Groq model.
# For example: llama-3.1-70b-versatile or mixtral-8x7b-32768
# GROQ_MODEL=llama-3.1-70b-versatile
